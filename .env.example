# ===========================================
# Moodle Learn Project - Environment Template
# ===========================================
# Copy this file to .env and configure your settings
# 
# SECURITY NOTE: Never commit .env files to version control!
# This file contains example values - replace with your actual values
#
# Created: September 2025
# ===========================================

# ===========================================
# MOODLE CONFIGURATION
# ===========================================
# Port where Moodle will be accessible
# Access: http://localhost:MOODLE_PORT
MOODLE_PORT=2080

# ===========================================
# POSTGRESQL DATABASE SETTINGS
# ===========================================
# Main database for Moodle
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=your_secure_password_here

# Database connection settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===========================================
# PGADMIN SETTINGS
# ===========================================
# Web interface for PostgreSQL management
# Access: http://localhost:PGADMIN_PORT
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=your_pgadmin_password

# ===========================================
# KEYCLOAK SETTINGS (SSO/Authentication)
# ===========================================
# Single Sign-On authentication server
# Access: http://localhost:KEYCLOAK_PORT
KEYCLOAK_PORT=8180
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# ===========================================
# AI INTEGRATION SETTINGS (MOODLE 5.0)
# ===========================================

# ----- OpenAI Configuration (Paid Service) -----
# Get API key from: https://platform.openai.com/api-keys
# Cost: ~$10-50/month depending on usage
#OPENAI_API_KEY=sk-your-openai-api-key-here
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_ORG_ID=your-org-id-optional

# ----- Google Gemini Configuration (Free Tier Available) -----
# Get API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 requests per minute, 1500 per day
#GEMINI_API_KEY=your-gemini-api-key-here
#GEMINI_MODEL=gemini-1.5-flash

# ----- Azure OpenAI Configuration -----
# For enterprise customers using Azure
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
#AZURE_OPENAI_API_KEY=your-azure-api-key
#AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# ----- Ollama Configuration (Local AI - Free) -----
# Local AI server - completely free but needs powerful hardware
# Download from: https://ollama.ai
#OLLAMA_API_ENDPOINT=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b
#OLLAMA_TEMPERATURE=0.7

# ----- AI Usage Limits & Safety -----
# Daily request limits per user (recommended: 20-100)
#AI_DAILY_REQUESTS_PER_USER=50

# Monthly cost limit in USD (recommended: $20-100)
#AI_MONTHLY_COST_LIMIT=100.00

# Enable/disable AI features
#AI_COURSE_GENERATION=true
#AI_QUIZ_GENERATION=true
#AI_STUDENT_ASSISTANCE=true
#AI_CONTENT_SUMMARIZATION=true

# ===========================================
# GOOGLE CLOUD STORAGE (GCS) SETTINGS
# ===========================================
# For file storage in Google Cloud
# Service account file should be placed in: ./gcs/service-account.json
#GCS_PROJECT_ID=your-gcp-project-id
#GCS_BUCKET_NAME=your-moodle-storage-bucket
#GCS_SERVICE_ACCOUNT_PATH=/var/www/html/gcs/service-account.json

# ===========================================
# REDIS CACHE SETTINGS (Optional)
# ===========================================
# For improved performance with caching
#REDIS_HOST=redis
#REDIS_PORT=6379
#REDIS_PASSWORD=your_redis_password
#REDIS_DB=0

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
# SMTP settings for email notifications
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USERNAME=your-email@gmail.com
#SMTP_PASSWORD=your-app-password
#SMTP_ENCRYPTION=tls

# ===========================================
# SSL/TLS SETTINGS (Production)
# ===========================================
# For HTTPS in production environment
#SSL_CERTIFICATE_PATH=/etc/ssl/certs/moodle.crt
#SSL_PRIVATE_KEY_PATH=/etc/ssl/private/moodle.key
#ENABLE_HTTPS=false

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
# Automated backup settings
#BACKUP_SCHEDULE=0 2 * * *
#BACKUP_RETENTION_DAYS=30
#BACKUP_STORAGE_PATH=/backups
#BACKUP_COMPRESS=true

# ===========================================
# MONITORING & LOGGING
# ===========================================
# Application monitoring settings
#LOG_LEVEL=info
#ENABLE_DEBUG=false
#MONITORING_ENDPOINT=https://your-monitoring-service.com

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Only for development environment
#DEVELOPMENT_MODE=false
#ENABLE_XDEBUG=false
#SHOW_ERRORS=false

# ===========================================
# SECURITY SETTINGS
# ===========================================
# Security configurations
#SESSION_TIMEOUT=3600
#PASSWORD_MIN_LENGTH=8
#ENABLE_2FA=true
#MAX_LOGIN_ATTEMPTS=5

# ===========================================
# PERFORMANCE TUNING
# ===========================================
# PHP and application performance settings
#PHP_MEMORY_LIMIT=512M
#PHP_MAX_EXECUTION_TIME=300
#PHP_UPLOAD_MAX_FILESIZE=100M
#PHP_POST_MAX_SIZE=100M

# ===========================================
# EXTERNAL INTEGRATIONS
# ===========================================
# Third-party service integrations
#ZOOM_API_KEY=your-zoom-api-key
#TEAMS_WEBHOOK_URL=your-teams-webhook
#SLACK_WEBHOOK_URL=your-slack-webhook

# ===========================================
# NOTES & INSTRUCTIONS
# ===========================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual values
# 3. Never commit .env to version control
# 4. Keep .env.example updated when adding new variables
# 5. Use strong passwords for all services
# 6. Enable AI features gradually and monitor usage/costs
# 7. Test configuration with: docker-compose config