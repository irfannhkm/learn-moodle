# Moodle 5.0 AI Configuration Environment Variables
# Copy this file to .env and configure your AI providers

# ============================================
# OpenAI Configuration (GPT-4, GPT-3.5)
# ============================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id-optional
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# ============================================
# Azure OpenAI Configuration
# ============================================
# For enterprise users with Azure OpenAI service
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-gpt-4-deployment

# ============================================
# Ollama Configuration (Local AI)
# ============================================
# For running AI models locally
OLLAMA_API_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_TEMPERATURE=0.7

# ============================================
# Google Gemini Configuration
# ============================================
# Google's AI model (has free tier)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PROJECT_ID=your-google-cloud-project

# ============================================
# Anthropic Claude Configuration
# ============================================
# Claude AI from Anthropic
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MAX_TOKENS=2048

# ============================================
# AI Usage Limits & Controls
# ============================================
# Daily limits per user
AI_DAILY_REQUESTS_PER_USER=50
AI_DAILY_TOKENS_PER_USER=10000

# Monthly cost limits (in USD)
AI_MONTHLY_COST_LIMIT=100.00

# Enable/disable features
AI_COURSE_DESCRIPTION_ENABLED=true
AI_QUIZ_GENERATION_ENABLED=true
AI_STUDENT_EXPLAIN_ENABLED=true
AI_CONTENT_GENERATION_ENABLED=true

# ============================================
# Privacy & Security Settings
# ============================================
# Whether to log AI interactions
AI_LOG_INTERACTIONS=true

# Content filtering
AI_CONTENT_FILTERING_ENABLED=true

# Data retention (days)
AI_LOG_RETENTION_DAYS=90

# ============================================
# Performance Settings
# ============================================
# Timeout for AI requests (seconds)
AI_REQUEST_TIMEOUT=30

# Cache AI responses (true/false)
AI_CACHE_RESPONSES=true

# Cache duration (minutes)
AI_CACHE_DURATION=1440

# ============================================
# Development/Testing Settings
# ============================================
# Enable debug mode for AI
AI_DEBUG_MODE=false

# Test mode (doesn't consume real tokens)
AI_TEST_MODE=false
