MOODLE_PORT=2080

# PostgreSQL Settings
POSTGRES_DB=moodle
POSTGRES_USER=moodle
POSTGRES_PASSWORD=Admin@123456!

# pgAdmin Settings
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=Admin@123456!

# Redis Settings
REDIS_HOST=moodle-redis
REDIS_PORT=6099

# Keycloak Settings
KEYCLOAK_PORT=8180
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=Admin@123456!

# AI Configuration (Optional - uncomment and configure as needed)
# OpenAI Settings
#OPENAI_API_KEY=sk-your-openai-api-key-here
#OPENAI_MODEL=gpt-4o-mini

# Ollama Settings (Local AI)
#OLLAMA_API_ENDPOINT=http://localhost:11434
#OLLAMA_MODEL=llama3.1:8b

# AI Usage Limits
#AI_DAILY_REQUESTS_PER_USER=50
#AI_MONTHLY_COST_LIMIT=100.00

# Production environment (minimal)
# Copy to .env on production server before running docker compose.

# # Public port exposed by Moodle container
# MOODLE_PORT=80

# # Internal Redis port used by moodle-redis service and healthcheck
# REDIS_PORT=6099

